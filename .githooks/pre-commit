#!/usr/bin/env bash
#
# Pre-commit: refresh the codegraph index when `codegraph` is on PATH. If it is
# missing or the index run fails, the hook logs a note and lets the commit
# proceed - codegraph is an optional developer convenience, never a gate.
#
# Enabled per-clone by `git config core.hooksPath .githooks`, which the root
# package.json "prepare" script runs automatically on `pnpm install`.

set -euo pipefail

if ! command -v codegraph > /dev/null 2>&1; then
	echo "[pre-commit] codegraph not found; skipping index refresh." >&2
	exit 0
fi

if ! codegraph index --quiet; then
	echo "[pre-commit] codegraph index failed; continuing without a fresh index." >&2
fi

exit 0
